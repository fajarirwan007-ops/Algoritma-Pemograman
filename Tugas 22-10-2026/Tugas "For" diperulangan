for perulangan in range(1, 51):
    angka = 5 + (perulangan - 1) * 3
    kuadrat = angka ** 2
    kali_empat = angka * 4
    tambah_sepuluh = angka + 10
    kurang_dua = angka - 2
    print("-" * 45)
    print(f"Perulangan ke-{perulangan}")
    print(f"Angka: {angka}")
    print(f"Kuadrat: {kuadrat}")
    print(f"Kali Empat: {kali_empat}")
    print(f"Tambah Sepuluh: {tambah_sepuluh}")
    print(f"Kurang Dua: {kurang_dua}")
